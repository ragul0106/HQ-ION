# Copy to .env and edit. .env is git-ignored. Never put private keys here:
# signing keys belong to the ONIX adapter, not to this app.

# Which ION environment this process talks to. REQUIRED, no default, so a live run is always deliberate.
#   sandbox | pilot | live
ION_ENV=sandbox

# Where personal data would live. Informational today (this app stores none); logged on every line.
DATA_REGION=in-local-dev

# This app
PORT=3102
# 127.0.0.1 = this machine only. Use 0.0.0.0 when the ONIX adapter runs in Docker and must reach this app.
HOST=0.0.0.0
LOG_LEVEL=info

# Network identity (the testnet's shared demo values; use your own Devlabs values for sandbox/pilot/live)
NETWORK_ID=ion.id/staging
BPP_ID=dc-bpp.ion.id
BPP_URI=http://reverse-proxy:9000/bpp/receiver

# The ONIX seller adapter (this app calls these; the adapter calls this app's /api/webhook/<action>)
ADAPTER_CALLER_URL=http://localhost:8082/bpp/caller
ADAPTER_PUBLISH_URL=http://localhost:8082/catalog/publish

# Scheme files (one JSON file per scheme)
SCHEMES_DIR=./data/schemes

# TEMPORARY stand-in schemas (until ION's government-benefits schema is confirmed). Served by the testnet proxy.
SCHEMA_BASE_URL=http://reverse-proxy:9000/schema
