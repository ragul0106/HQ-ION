    {
      "name": "2 Through ION (adapters)",
      "item": [
        {
          "name": "select via the BUYER ADAPTER (exporter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "The real ION path: buyer adapter -> seller adapter -> seller app. Only the ACK comes back here; run `npm run listen` to see the on_select with 2 schemes.",
            "url": {
              "raw": "{{bap_caller_url}}/select",
              "host": ["{{bap_caller_url}}"],
              "path": ["select"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"action\": \"select\",\n    \"version\": \"2.0.0\",\n    \"networkId\": \"{{network_id}}\",\n    \"bapId\": \"{{bap_id}}\",\n    \"bapUri\": \"{{bap_uri}}\",\n    \"bppId\": \"{{bpp_id}}\",\n    \"bppUri\": \"{{bpp_uri}}\",\n    \"transactionId\": \"{{$guid}}\",\n    \"messageId\": \"{{$guid}}\",\n    \"timestamp\": \"{{$isoTimestamp}}\",\n    \"ttl\": \"PT30S\",\n    \"schemaContext\": []\n  },\n  \"message\": {\n    \"contract\": {\n      \"id\": \"check-1\",\n      \"participants\": [\n        {\n          \"id\": \"buyer-1\",\n          \"descriptor\": {\n            \"code\": \"buyer\"\n          }\n        }\n      ],\n      \"commitments\": [\n        {\n          \"id\": \"commitment-1\",\n          \"status\": {\n            \"code\": \"DRAFT\"\n          },\n          \"resources\": [\n            {\n              \"id\": \"HQ-ELIGIBILITY-CHECK\",\n              \"descriptor\": {\n                \"name\": \"Scheme eligibility check\"\n              },\n              \"quantity\": {\n                \"unitQuantity\": 1,\n                \"unitCode\": \"UNIT\"\n              }\n            }\n          ],\n          \"offer\": {\n            \"id\": \"offer-eligibility\",\n            \"resourceIds\": [\n              \"HQ-ELIGIBILITY-CHECK\"\n            ]\n          }\n        }\n      ],\n      \"contractAttributes\": {\n        \"@context\": \"{{schema_base_url}}/HqMsmeProfile/v0/context.jsonld\",\n        \"@type\": \"HqMsmeProfile\",\n        \"language\": \"en\",\n        \"msmeProfile\": {\n          \"businessType\": \"CV\",\n          \"sector\": \"craft\",\n          \"province\": \"Bali\",\n          \"workerCount\": 25,\n          \"annualTurnoverIdr\": 1500000000,\n          \"hasNIB\": true,\n          \"exportsOrPlansToExport\": true\n        }\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 and ACK', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().message.status).to.eql('ACK');",
                  "});",
                  "",
                  "// remember this select's id, so the next request can fetch its answer from the listener",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('last_message_id', pm.response.json().message.messageId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "\u2192 the ANSWER to the select above (through ION)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// the answer is sent just after the ACK; give it a moment to arrive",
                  "setTimeout(function () {}, 1500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the on_select answer arrived, with 2 scheme(s)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.context.action).to.eql('on_select');",
                  "  const e = body.message.contract.contractAttributes.eligibility;",
                  "  pm.expect(e.eligibleCount).to.eql(2);",
                  "  console.log('schemes:', e.schemes.map(s => s.id).join(', ') || '(none)');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "The seller's answer (the on_select message). A Beckn request only returns an ACK; the answer is a separate callback that Postman cannot receive, so it is read from the listener. Keep `npm run listen` running. The listener finds it by the messageId saved from the select above.",
            "url": {
              "raw": "{{listener_url}}/callbacks/{{last_message_id}}",
              "host": ["{{listener_url}}"],
              "path": ["callbacks", "{{last_message_id}}"]
            }
          }
        },
        {
          "name": "select via the buyer adapter with a phone number (refused)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{bap_caller_url}}/select",
              "host": ["{{bap_caller_url}}"],
              "path": ["select"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"action\": \"select\",\n    \"version\": \"2.0.0\",\n    \"networkId\": \"{{network_id}}\",\n    \"bapId\": \"{{bap_id}}\",\n    \"bapUri\": \"{{bap_uri}}\",\n    \"bppId\": \"{{bpp_id}}\",\n    \"bppUri\": \"{{bpp_uri}}\",\n    \"transactionId\": \"{{$guid}}\",\n    \"messageId\": \"{{$guid}}\",\n    \"timestamp\": \"{{$isoTimestamp}}\",\n    \"ttl\": \"PT30S\",\n    \"schemaContext\": []\n  },\n  \"message\": {\n    \"contract\": {\n      \"id\": \"check-1\",\n      \"participants\": [\n        {\n          \"id\": \"buyer-1\",\n          \"descriptor\": {\n            \"code\": \"buyer\"\n          }\n        }\n      ],\n      \"commitments\": [\n        {\n          \"id\": \"commitment-1\",\n          \"status\": {\n            \"code\": \"DRAFT\"\n          },\n          \"resources\": [\n            {\n              \"id\": \"HQ-ELIGIBILITY-CHECK\",\n              \"descriptor\": {\n                \"name\": \"Scheme eligibility check\"\n              },\n              \"quantity\": {\n                \"unitQuantity\": 1,\n                \"unitCode\": \"UNIT\"\n              }\n            }\n          ],\n          \"offer\": {\n            \"id\": \"offer-eligibility\",\n            \"resourceIds\": [\n              \"HQ-ELIGIBILITY-CHECK\"\n            ]\n          }\n        }\n      ],\n      \"contractAttributes\": {\n        \"@context\": \"{{schema_base_url}}/HqMsmeProfile/v0/context.jsonld\",\n        \"@type\": \"HqMsmeProfile\",\n        \"language\": \"en\",\n        \"msmeProfile\": {\n          \"sector\": \"food\",\n          \"phone\": \"+628100000000\"\n        }\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused by the adapter schema check', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().message.error.code).to.eql('SCH_FIELD_NOT_ALLOWED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "seller adapter called UNSIGNED (refused)",
          "request": {
            "method": "POST",
            "header": [
