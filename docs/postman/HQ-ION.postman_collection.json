{
  "info": {
    "name": "HQ-ION seller (ION testnet)",
    "description": "Requests for the Haqdarshak seller on the local ION testnet.\n\nStart the testnet and the seller app first (docs/LOCAL_TESTNET.md), and run `npm run listen` in a terminal. Select the environment `HQ-ION local testnet`.\n\nA Beckn request returns only an ACK. The answer (on_select, with the schemes) is a separate callback that Postman cannot receive, so each select is followed by an 'ANSWER' request that fetches it from the listener.\n\nMessage ids come from {{$guid}}, so every send is new.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Seller app (direct, port 3102)",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Is the HQ-ION seller app running?",
            "url": {
              "raw": "{{seller_url}}/health",
              "host": ["{{seller_url}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('seller app is up', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "select: food stall (3 schemes)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "ACK now. The answer (on_select, 3 schemes) goes to the adapter and then to the buyer listener: run `npm run listen` to see it.",
            "url": {
              "raw": "{{seller_url}}/api/webhook/select",
              "host": ["{{seller_url}}"],
              "path": ["api", "webhook", "select"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"action\": \"select\",\n    \"version\": \"2.0.0\",\n    \"networkId\": \"{{network_id}}\",\n    \"bapId\": \"{{bap_id}}\",\n    \"bapUri\": \"{{bap_uri}}\",\n    \"bppId\": \"{{bpp_id}}\",\n    \"bppUri\": \"{{bpp_uri}}\",\n    \"transactionId\": \"{{$guid}}\",\n    \"messageId\": \"{{$guid}}\",\n    \"timestamp\": \"{{$isoTimestamp}}\",\n    \"ttl\": \"PT30S\"\n  },\n  \"message\": {\n    \"contract\": {\n      \"id\": \"check-1\",\n      \"participants\": [\n        {\n          \"id\": \"buyer-1\",\n          \"descriptor\": {\n            \"code\": \"buyer\"\n          }\n        }\n      ],\n      \"commitments\": [\n        {\n          \"id\": \"commitment-1\",\n          \"resources\": [\n            {\n              \"id\": \"HQ-ELIGIBILITY-CHECK\"\n            }\n          ],\n          \"offer\": {\n            \"id\": \"offer-eligibility\",\n            \"resourceIds\": [\n              \"HQ-ELIGIBILITY-CHECK\"\n            ]\n          }\n        }\n      ],\n      \"contractAttributes\": {\n        \"@context\": \"{{schema_base_url}}/HqMsmeProfile/v0/context.jsonld\",\n        \"@type\": \"HqMsmeProfile\",\n        \"language\": \"en\",\n        \"msmeProfile\": {\n          \"businessType\": \"individual\",\n          \"sector\": \"food\",\n          \"province\": \"Jawa Tengah\",\n          \"workerCount\": 3,\n          \"annualTurnoverIdr\": 300000000,\n          \"hasNIB\": true,\n          \"exportsOrPlansToExport\": false\n        }\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 and ACK', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().message.status).to.eql('ACK');",
                  "});",
                  "",
                  "// remember this select's id, so the next request can fetch its answer from the listener",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('last_message_id', pm.response.json().message.messageId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "\u2192 the ANSWER to the select above (food stall)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// the answer is sent just after the ACK; give it a moment to arrive",
                  "setTimeout(function () {}, 1500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the on_select answer arrived, with 3 scheme(s)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.context.action).to.eql('on_select');",
                  "  const e = body.message.contract.contractAttributes.eligibility;",
                  "  pm.expect(e.eligibleCount).to.eql(3);",
                  "  console.log('schemes:', e.schemes.map(s => s.id).join(', ') || '(none)');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "The seller's answer (the on_select message). A Beckn request only returns an ACK; the answer is a separate callback that Postman cannot receive, so it is read from the listener. Keep `npm run listen` running. The listener finds it by the messageId saved from the select above.",
            "url": {
              "raw": "{{listener_url}}/callbacks/{{last_message_id}}",
              "host": ["{{listener_url}}"],
              "path": ["callbacks", "{{last_message_id}}"]
            }
          }
        },
